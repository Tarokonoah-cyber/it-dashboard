{
  "name": "taroko-it-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-vm-modules scripts/validate-line-messages.mjs",
    "build": "next build",
    "start": "next start",
    "upload:soc-sop": "node scripts/upload-soc-sop.ts",
    "import:sports": "node scripts/importSportsEvents.js",
    "import:sports:folder": "node scripts/importSportsEvents.js",
    "import:sports:all": "node scripts/importSportsEvents.js --all",
    "sports:sync:baseball": "node scripts/syncBaseball.js --league=MLB,NPB,CPBL",
    "sports:sync:mlb": "node scripts/syncBaseball.js --league=MLB",
    "sports:sync:npb": "node scripts/syncBaseball.js --league=NPB",
    "sports:sync:cpbl": "node scripts/syncBaseball.js --league=CPBL",
    "sync:sports-details": "node scripts/syncSportsDetails.js",
    "sync:sports:details": "node scripts/syncSportsDetails.js",
    "import:assets": "python scripts/import_assets_from_xlsx.py",
    "lint": "eslint .",
    "test:e2e": "playwright test e2e/mobile-visual.spec.mjs e2e/pwa-mobile.spec.mjs",
    "test:e2e:update": "playwright test e2e/mobile-visual.spec.mjs --update-snapshots",
    "test:pwa": "playwright test e2e/pwa-mobile.spec.mjs",
    "qa:mobile": "playwright test e2e/mobile-audit.spec.mjs",
    "validate:line": "node --experimental-vm-modules scripts/validate-line-messages.mjs",
    "test": "node --experimental-vm-modules --test scripts/ai-assistant.test.mjs scripts/auth.test.mjs scripts/asset-lifecycle.test.mjs scripts/calendar-reminders.test.mjs scripts/cost-control.test.mjs scripts/dashboard-api.test.mjs scripts/data-edit-mode.test.mjs scripts/knowledge-security.test.mjs scripts/line-repair-webhook.test.mjs scripts/line-smart-notifications.test.mjs scripts/mobile-dashboard-layout.test.mjs scripts/mobile-navigation.test.mjs scripts/notifications.test.mjs scripts/room-number.test.mjs scripts/search-report.test.mjs scripts/recurring-reminder.test.mjs scripts/supabase-rest.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-tc": "^0.4.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0"
  }
}
